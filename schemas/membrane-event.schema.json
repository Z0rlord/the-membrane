{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-membrane.xyz/schemas/membrane-event.schema.json",
  "title": "MembraneEvent",
  "description": "Canonical attestation bus envelope (whitepaper §11.3)",
  "type": "object",
  "required": [
    "version",
    "type",
    "subject_pubkey",
    "prev_cp_hash",
    "timestamp",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "0.9.14"
    },
    "type": {
      "type": "string",
      "enum": [
        "membrane.cp.liveness",
        "membrane.cp.router",
        "membrane.cp.bci",
        "membrane.iac",
        "membrane.anchor.ots",
        "membrane.alert.degraded",
        "membrane.action.blocked"
      ]
    },
    "subject_pubkey": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "prev_cp_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "oneOf": [
        { "$ref": "#/$defs/routerPayload" },
        { "type": "object" }
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{128}$"
    }
  },
  "$defs": {
    "routerPayload": {
      "type": "object",
      "required": [
        "model_id",
        "context_merkle_root",
        "session_nonce",
        "parent_cp_hash",
        "iac_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "context_merkle_root": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "session_nonce": { "type": "integer", "minimum": 0 },
        "parent_cp_hash": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "iac_hash": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    }
  }
}
